# 确保所有 SQL 迁移文件使用 LF 换行符
backend/migrations/*.sql text eol=lf

# Go 源代码文件
*.go text eol=lf

# 前端 源代码文件
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.vue text eol=lf

# Shell 脚本
*.sh text eol=lf

# YAML/YML 配置文件
*.yaml text eol=lf
*.yml text eol=lf

# Dockerfile
Dockerfile text eol=lf

# 版本特征库模板与抓包 golden：必须逐字节入库，
# 换行被转换会让 profiles.json 里的 SHA256 与实际文件对不上。
backend/internal/pkg/claude/versionprofiles/** -text
backend/testdata/cccaptures/** -text
